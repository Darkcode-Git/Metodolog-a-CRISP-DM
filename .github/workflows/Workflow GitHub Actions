name: Stock ML CI/CD Pipeline

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
    - name: Checkout Código
      uses: actions/checkout@v4

    - name: Configurar Python 3.12
      uses: actions/setup-python@v5
      with:
        python-version: '3.12'
        cache: 'pip'

    - name: Instalar Dependencias
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt pytest flake8

    - name: Linter con Flake8
      run: |
        flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics

    - name: Ejecutar Pruebas Automatizadas (Pytest)
      run: |
        pytest tests/ --doctest-modules --junitxml=junit/test-results.xml

  deploy-to-cloud:
    needs: build-and-test
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
    - name: Despliegue en Servicio Cloud (streamlit.app)
      env:
        DEPLOY_TOKEN: ${{ secrets.CLOUD_DEPLOY_TOKEN }}
      run: |
        echo "Desplegando servicio bursátil en plataforma cloud..."
        echo "Monitorización activada para métricas tipo Vantage."
