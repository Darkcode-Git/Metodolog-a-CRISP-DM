# File: .github/workflows/ci-cd.yml
name: CI/CD Pipeline - Stock Analysis & Machine Learning

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  test-and-lint:
    name: Build, Lint & Automated Tests (CI)
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.10", "3.11"]

    steps:
      - name: 1. Checkout Source Code
        uses: actions/checkout@v4

      - name: 2. Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          cache: 'pip'

      - name: 3. Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install flake8 pytest pytest-cov
          if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

      - name: 4. Code Quality & Linting (flake8)
        run: |
          # Detiene la ejecución si hay errores de sintaxis o variables no definidas
          flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
          # Advertencias de estilo (E501 longitud de línea)
          flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127 --statistics

      - name: 5. Execute Automated Tests (pytest)
        run: |
          pytest --doctest-modules --junitxml=junit/test-results.xml --cov=. --cov-report=xml

  deploy:
    name: Continuous Deployment to Cloud (CD)
    needs: test-and-lint
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - name: 1. Checkout Repository
        uses: actions/checkout@v4

      - name: 2. Trigger Cloud Deployment Webhook
        env:
          DEPLOY_WEBHOOK_URL: ${{ secrets.DEPLOY_WEBHOOK_URL }}
        run: |
          echo "[+] Pipeline CI exitoso. Iniciando Despliegue en Producción..."
          if [ -n "$DEPLOY_WEBHOOK_URL" ]; then
            curl -X POST "$DEPLOY_WEBHOOK_URL" -f
            echo "[✓] Notificación de despliegue enviada con éxito."
          else
            echo "[i] Simulación de despliegue continuo completada satisfactoriamente."
          fi
