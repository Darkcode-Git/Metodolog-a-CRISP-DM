import yfinance as yf
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, r2_score

def obtener_datos_bursatiles(ticker="AAPL", periodo="2y"):
    df = yf.download(ticker, period=periodo, interval="1d")
    df['SMA_20'] = df['Close'].rolling(window=20).mean()
    df['SMA_50'] = df['Close'].rolling(window=50).mean()
    df['Volatilidad'] = df['Close'].pct_change().rolling(window=10).std()
    df.dropna(inplace=True)
    return df

def entrenar_modelo_optimo(df):
    features = ['Open', 'High', 'Low', 'Volume', 'SMA_20', 'SMA_50', 'Volatilidad']
    X = df[features]
    y = df['Close']
    
    split = int(len(df) * 0.8)
    X_train, X_test = X.iloc[:split], X.iloc[split:]
    y_train, y_test = y.iloc[:split], y.iloc[split:]
    
    # Modelo con hiperparámetros optimizados
    model = RandomForestRegressor(n_estimators=250, max_depth=12, min_samples_split=5, random_state=42)
    model.fit(X_train, y_train.values.ravel())
    
    preds = model.predict(X_test)
    r2 = r2_score(y_test, preds)
    rmse = np.sqrt(mean_squared_error(y_test, preds))
    return model, r2, rmse
